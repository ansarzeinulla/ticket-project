# BiletFlow - local database environment
# Copy to .env before running `docker compose up`.

POSTGRES_USER=biletflow
POSTGRES_PASSWORD=biletflow_dev_password
POSTGRES_DB=biletflow

# Host port for the PostgreSQL container (container always listens on 5432).
# 5433 is used by default so it does not clash with a locally installed PostgreSQL.
POSTGRES_PORT=5433

# Optional pgAdmin container (started only with: docker compose --profile tools up)
PGADMIN_EMAIL=admin@biletflow.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Phase 2: Go API ---------------------------------------------------------

# development | production. Production refuses to start without JWT_SECRET.
BILETFLOW_ENV=development

API_HOST=0.0.0.0
API_PORT=8080

# The API connects over the host port above, so it can run outside Docker.
DATABASE_URL=postgres://biletflow:biletflow_dev_password@localhost:5433/biletflow?sslmode=disable

# Signing key for access tokens. Generate a real one for anything shared:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ISSUER=biletflow
ACCESS_TOKEN_TTL=24h

# bcrypt work factor. 12 is the production default; the tests drop it to 4.
BCRYPT_COST=12

# --- Email (BF-100) -----------------------------------------------------------
# Leave SMTP_HOST empty and every email is printed in the API terminal instead
# of being sent. To really send through Gmail:
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Create an app password: Google Account > Security > App passwords.
#   3. Fill these in with that address and the 16-letter app password.
# Gmail always sends from the account's own address; only the name can change.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USERNAME=biletflow.demo@gmail.com
#   SMTP_PASSWORD="abcdefghijklmnop"
#   MAIL_FROM="BiletFlow <biletflow.demo@gmail.com>"
# Keep the quotes: `make api-run` reads this file with the shell, which would
# treat a space or the < > as part of a command.

# --- Hosting (BF-100) ---------------------------------------------------------
# Only for deploy/oracle: the public address Caddy serves over HTTPS, for
# example 141-147-1-2.sslip.io. deploy/oracle/setup.sh fills it in.
DOMAIN=
